# Langflow
LANGFLOW_SERVER_URL=http://127.0.0.1:7860
LANGFLOW_API_KEY=

# Flow IDs (dari Langflow)
FLOW_KONSULTAN_RESELL=
FLOW_REKOMENDASI_HARGA=
FLOW_DESKRIPSI_CAPTION=
FLOW_PERBANDINGAN_HARGA_BELI_JUAL=
FLOW_PERBANDINGAN_MARKETPLACE=
FLOW_KONSULTASI_ONGKIR=
# Foto Editor — validator must return JSON { is_valid_object, is_sellable, identified_item, reason }
FLOW_FOTO_VALIDATOR=
# Editor must return JSON { image_base64 } containing the final image (base64 or image data URL)
FLOW_FOTO_EDITOR=
# Draf balasan AI untuk Inbox Pesan
FLOW_INBOX_REPLY_DRAFT=

# Remove.bg — hapus background foto produk secara otomatis
# Daftar gratis di: https://www.remove.bg/api
REMOVE_BG_API_KEY=

PORT=3000

# Composio (opsional — user bisa isi via UI per-profil)
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_ID=

# Meta (Facebook App) untuk Instagram OAuth langsung — cara Muse AI
# Buat app di https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/meta/callback

# Callback URL untuk OAuth
CALLBACK_URL=http://localhost:3000/auth/callback
APP_USER_ID=user-123
